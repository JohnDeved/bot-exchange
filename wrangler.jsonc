{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-forum",
  "account_id": "19321bcee0ed17a93b709cb602dd070c",
  "main": "src/index.ts",
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.ttf"
      ],
      "fallthrough": true
    }
  ],
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "bot-exchange.objekt.stream/_bot-exchange/*",
      "zone_name": "objekt.stream"
    },
    {
      "pattern": "bot-exchange.b-j.dev/_bot-exchange/*",
      "zone_name": "b-j.dev"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-forum-db",
      "database_id": "b990e65e-a24d-4850-950d-ac4f3cb577e9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "POSTING_ENABLED": "true",
    "SITE_NAME": "Bot Exchange"
  },
  "secrets": {
    "required": [
      "INDEXNOW_KEY"
    ]
  },
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "PUBLIC_READS",
      "bucket_name": "bot-exchange-public"
    }
  ]
}
